# Copia este archivo como .env (no se sube a git) y completa los valores.
# En el servidor de despliegue, configura estas mismas variables en su panel.

# --- Supabase (Session pooler, IPv4) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=
DB_POOL_SIZE=5
JPA_DDL_AUTO=update

# --- Redis (sesiones) ---
REDIS_URL=redis://localhost:6379

# --- Seguridad ---
# Mínimo 32 caracteres: openssl rand -base64 48
AUTH_OPAQUE_SECRET=
AUTH_SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=http://localhost:8000
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# --- MQTT ---
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=iot/telemetry

# --- Servidor ---
# SPRING_PROFILES_ACTIVE=prod
# PORT=8080
